{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cdi:discharge_summary.v3",
  "title": "Discharge summary extraction (v3, relaxed; also used for operative notes)",
  "type": "object",
  "properties": {
    "patient": {"$ref": "cdi:common.defs#/$defs/patient"},
    "admission_date": {"$ref": "cdi:common.defs#/$defs/date_text"},
    "discharge_date": {"$ref": "cdi:common.defs#/$defs/date_text"},
    "diagnoses": {"$ref": "cdi:common.defs#/$defs/coded_list"},
    "procedures": {"$ref": "cdi:common.defs#/$defs/procedure_list"},
    "investigations": {"$ref": "cdi:common.defs#/$defs/lab_list"},
    "vitals": {"$ref": "cdi:common.defs#/$defs/vital_list"},
    "medications": {"$ref": "cdi:common.defs#/$defs/medication_list"},
    "allergies": {"$ref": "cdi:common.defs#/$defs/allergy_list"},
    "advice": {"$ref": "cdi:common.defs#/$defs/text_list"},
    "confidence": {"$ref": "cdi:common.defs#/$defs/confidence"}
  },
  "required": ["confidence"],
  "additionalProperties": false
}
