# Pod configuration (copied to /workspace/cdi/.env on first boot). NO credentials here (backlog
# E1-S5): CDI_DATABASE_URL, CDI_REDIS_URL, CDI_S3_ACCESS_KEY and CDI_S3_SECRET_KEY are read from the
# secrets store. bootstrap_pod.sh generates it once in /workspace/secrets and copies it into
# CDI_SECRETS_DIR (0700 dir / 0600 files) on every boot. See docs/secrets.md.
CDI_SECRETS_DIR=/run/cdi-secrets
CDI_S3_ENDPOINT_URL=http://127.0.0.1:9000
CDI_S3_BUCKET=cdi-documents
CDI_INBOX_DIR=/workspace/data/inbox
CDI_PROCESSED_DIR=/workspace/data/processed
CDI_FAILED_DIR=/workspace/data/failed
CDI_PAGE_DPI=200
CDI_WEBAPP_PORT=8888
# E10-S1: the web app's Prometheus /metrics, bound to 127.0.0.1 only (0 = off)
CDI_METRICS_PORT=9464
# E10-S3: OpenTelemetry export to the local Tempo (traces) and Loki (logs), started by
# infra/monitoring/start_monitoring.sh; empty = off (trace ids still appear in the logs)
CDI_OTEL_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
CDI_OTEL_LOGS_ENDPOINT=http://127.0.0.1:3100/otlp/v1/logs
CDI_MLSERVE_URL=http://127.0.0.1:8077
CDI_MLSERVE_PORT=8077
CDI_MLSERVE_BACKEND=hf
CDI_VLLM_GUIDED=true
CDI_VLM_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
CDI_VLM_FALLBACK_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct
# model registry (backlog E10-S5, docs/model-rollout.md): the registered version this gateway
# serves and its pinned revision; empty = not registered. Router cache for the web app.
CDI_MODEL_VERSION=
CDI_VLM_MODEL_REVISION=
CDI_MODEL_ROUTE_TTL_S=5
# data-tier HA (backlog E10-S6, docs/ha.md): off by default. A hot standby on this host, and
# the app connecting to whichever server is writable. MinIO: single | erasure (one host,
# CDI_MINIO_DRIVES drives) | cluster (one process per host of CDI_MINIO_ADDRESSES; then list
# every host in CDI_S3_ENDPOINT_URL, comma-separated)
CDI_PG_STANDBY_PORT=
CDI_DATABASE_HOSTS=
CDI_MINIO_MODE=single
CDI_MINIO_ADDRESSES=127.0.0.1:9000
CDI_MINIO_DRIVES=4
CDI_VLM_MAX_PIXELS_OCR=2000000
# "" = bf16 weights (the pod); "8bit" only on a test host below 24 GB of GPU memory (docs/fallback-host.md)
CDI_VLM_QUANTIZE=
CDI_FAST_CLASSIFY=true
CDI_EXTRACT_RETRIES=1
CDI_JOB_MAX_WORKERS=6
CDI_EXTRACT_CONCURRENCY=0
# E2-S8: short documents of one type in one batched model call (1 = off until the GPU A/B)
CDI_EXTRACT_BATCH_MAX=1
CDI_EXTRACT_BATCH_MAX_BLOCKS=40
CDI_OCR_ENGINE=rapidocr
CDI_HANDWRITTEN_USES_VLM=true
CDI_IG_PACKAGE=ndhm.in#6.5.0
CDI_TERMINOLOGY_PACKAGE=in-snomed-loinc-icd10
CDI_FHIR_VALIDATOR_JAR=/workspace/tools/validator_cli.jar
CDI_FHIR_PACKAGE_HOME=/workspace/tools/fhir-home
# Stable counter address (backlog E1-S9, docs/ingress.md). Empty = no tunnel; the per-pod LIVE URL
# is then the only address. CDI_INGRESS_HOST_KEY is printed by infra/ingress/setup_ingress_vm.sh.
CDI_INGRESS_HOSTNAME=
CDI_INGRESS_SSH=
CDI_INGRESS_SSH_PORT=22
CDI_INGRESS_REMOTE_PORT=18888
CDI_INGRESS_HOST_KEY=
# Application tier (backlog E10-S9, docs/ha.md "Application tier"): CDI_WEBAPP_INSTANCES web app
# instances on 127.0.0.1:CDI_WEBAPP_BASE_PORT.. behind the Caddy balancer on CDI_WEBAPP_PORT;
# instance i's /metrics on CDI_METRICS_PORT + i - 1. Jobs are durable (web_job + staged uploads)
# and run on CDI_WORKERS Celery workers (queues cdi,cdi-web; /metrics on CDI_WORKER_METRICS_PORT
# + i - 1). A job whose runner dies is resumed once its lease (CDI_JOB_LEASE_S) runs out.
# E9-S2: those are the CPU pool (Phase 1 of each document). Extraction - the one GPU-bound stage -
# runs on CDI_GPU_WORKERS workers of its own on queue cdi-gpu, /metrics carrying on after the CPU
# pool's ports. So Phase-1 capacity is bought with CDI_WORKERS / CDI_WORKER_CPU_CONCURRENCY without
# changing GPU spend, and GPU capacity with CDI_GPU_WORKERS / CDI_WORKER_GPU_CONCURRENCY. Both
# concurrencies are 0 = auto (CPU: CDI_JOB_MAX_WORKERS, GPU: the gateway's extraction slots, E2-S2).
# Leave CDI_WORKER_ROLE unset: each worker's role follows the queues start_apptier.sh gives it.
CDI_WEBAPP_INSTANCES=2
CDI_WEBAPP_BASE_PORT=8881
CDI_JOB_EXECUTION=queue
CDI_WORKERS=2
CDI_WORKER_CONCURRENCY=0
CDI_GPU_WORKERS=1
CDI_WORKER_CPU_CONCURRENCY=0
CDI_WORKER_GPU_CONCURRENCY=0
CDI_WORKER_METRICS_PORT=9470
CDI_JOB_LEASE_S=30
CDI_JOB_UNCLAIMED_S=120
CDI_JOB_MAX_ATTEMPTS=3
# E9-S1: a schema migration with the cluster up (make migrate-live) holds the job queue, waits
# this long for the jobs and stages in flight to end, and never gates new claims for longer than
# CDI_MIGRATION_HOLD_S. A pipeline_run still "running" after the stale window is a dead worker.
# E9-S8: the Celery broker. Empty = CDI_REDIS_URL (what runs today); an amqp:// URL moves the
# broker to RabbitMQ with no code change, which is what scripts/broker_crash_drill.py compares.
CDI_BROKER_URL=
CDI_MIGRATION_DRAIN_S=120
CDI_MIGRATION_HOLD_S=900
CDI_MIGRATION_STAGE_STALE_S=600
CDI_LB_ADMIN_PORT=2020
CDI_MLSERVE_DOWN_S=15
