# Source-built MinIO: registry images for these releases are no longer available.
FROM golang:1.27.1 AS build
ARG MINIO_TAG=RELEASE.2025-10-15T17-29-55Z
ARG MINIO_COMMIT=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a
RUN --mount=type=secret,id=build_ca,target=/etc/ssl/certs/ca-certificates.crt git clone --depth 1 --branch "$MINIO_TAG" https://github.com/minio/minio.git /src \
 && cd /src && test "$(git rev-parse HEAD)" = "$MINIO_COMMIT"
WORKDIR /src
RUN --mount=type=secret,id=build_ca,target=/etc/ssl/certs/ca-certificates.crt CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS="-trimpath -mod=readonly" go build -o /minio .
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /minio /usr/local/bin/minio
ENTRYPOINT ["minio"]
