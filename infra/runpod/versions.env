# Pinned versions for the pod / fallback-host bootstrap (backlog E1-S4; ARCHITECTURE §3.3, App. B).
#
# The single place where a version is chosen. bootstrap_pod.sh sources this file AFTER .env, so no
# environment variable can override a pin, and `python -m cdi_adapter.podmanifest` checks every
# boot against it (drift = the bootstrap stops before the web app starts).
# Python packages are pinned, with hashes, in requirements.lock (generated from this file and
# pyproject.toml by scripts/lock_pod_deps.py). Upgrade process: infra/runpod/README.md "Upgrading a pin".
#
# Plain KEY=VALUE lines only: bash sources this file and podmanifest.py parses it.

# Ubuntu 24.04 archive frozen at one instant (snapshot.ubuntu.com): every apt install resolves the
# same package set, dependencies included, on every boot.
UBUNTU_SERIES=noble
UBUNTU_SNAPSHOT=20260920T000000Z

# the packages bootstrap_pod.sh installs, at their version in that snapshot. libcurl4t64 is pinned
# with curl (curl depends on its exact version): an image that already carries a newer libcurl4t64
# (vast.ai base image, Ubuntu 24.04.4, 2026-09-26: 10.15) otherwise fails with "held broken packages"
APT_PINS="postgresql-16=16.15-0ubuntu0.24.04.1 postgresql-client-16=16.15-0ubuntu0.24.04.1 redis-server=5:7.0.15-1ubuntu0.24.04.4 cron=3.0pl1-184ubuntu2 git=1:2.43.0-1ubuntu7.3 curl=8.5.0-2ubuntu10.13 libcurl4t64=8.5.0-2ubuntu10.13 libgl1=1.7.0-1build1 libglib2.0-0t64=2.80.0-6ubuntu3.8 python3-venv=3.12.3-0ubuntu2.1 autossh=1.4g-1 openjdk-21-jre-headless=21.0.12+8-1~24.04"

# interpreter series of the venv (App. B)
PYTHON_SERIES=3.12

# Go toolchain for the MinIO build; the sha256 is go.dev's published checksum for linux-amd64
GO_VERSION=1.27.1
GO_SHA256=63d339f0da5ab53635a56f2490a7984dfe12dfcff22ad749f63edaf590168445

# MinIO is built from source (no published binaries); the tag must resolve to this commit
MINIO_TAG=RELEASE.2025-10-15T17-29-55Z
MINIO_COMMIT=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a

# torch is inherited from the RunPod image; a fallback host with the hf backend installs this build
TORCH_VERSION=2.8.0+cu128
TORCHVISION_VERSION=0.23.0+cu128

# 8-bit weights for the hf gateway on a test host below the 24 GB bar (CDI_VLM_QUANTIZE=8bit,
# docs/fallback-host.md; the pod serves bf16). Not in requirements.lock: start_mlserve.sh installs
# this wheel, hash-checked, only when that setting is on. The sha256 is PyPI's manylinux x86_64 wheel.
BITSANDBYTES_VERSION=0.50.2
BITSANDBYTES_SHA256=55348a9a4a21bfd99cf8c7b32fe67b4030ae5c2a05738e03c1747f65fa6ec283

# resolver input for requirements.lock (App. B: the current hf serving backend)
TRANSFORMERS_VERSION=5.16.1

# vLLM model gateway (backlog E2-S1): vLLM 0.11.0 is the last release on torch 2.8.0 (App. B) and
# its model code predates transformers 5, so the gateway runs in its own venv (.venv-vllm) with
# the last transformers 4.x; requirements-vllm.lock pins that venv. Used when
# CDI_MLSERVE_BACKEND=vllm; the pipeline venv keeps TRANSFORMERS_VERSION.
VLLM_VERSION=0.11.0
VLLM_TRANSFORMERS_VERSION=4.57.6
TORCHAUDIO_VERSION=2.8.0+cu128

# Application-tier balancer (backlog E10-S9, infra/runpod/Caddyfile.lb): the same Caddy release as
# the E1-S9 ingress VM (infra/ingress/versions.env), here the linux-amd64 tarball; the sha512 is
# from caddy_<version>_checksums.txt of that release
CADDY_VERSION=2.11.4
CADDY_SHA512=8220d1f013b6f27510247b2360c9e0ca9f018feebd82515f07635318b34ff9777ccc8fd0b6e6f2486ce3a33fe389fbb7db12d05baa474f4587509fb4f5ebf1c9

# Test URL for a verification host (infra/colab/start_test_tunnel.sh): a Cloudflare quick tunnel
# (*.trycloudflare.com, no account) to the balancer, so testers need no Colab session. The
# linux-amd64 binary; sha256 from the release notes of that cloudflared release. Test hosts only
# (synthetic / de-identified data): it decrypts at Cloudflare, so a production pod is reached only
# through the E1-S9 ingress (infra/runpod/start_tunnel.sh), never this.
CLOUDFLARED_VERSION=2026.9.3
CLOUDFLARED_SHA256=77e26d8d900e0b8469f416239d14b5f296525fdf79fee6f511ef55609e3fbac2

# Monitoring (backlog E10-S2, infra/monitoring/): native release tarballs, sha256 as published by
# each project (prometheus/alertmanager sha256sums.txt, dl.grafana.com *.sha256). Loopback only.
PROMETHEUS_VERSION=3.14.0
PROMETHEUS_SHA256=f665c6da19eb7ba399c915d30c7d9793c9b417bf8a749b504bc470678631478d
ALERTMANAGER_VERSION=0.34.1
ALERTMANAGER_SHA256=265b9d1e55ef0d5306a436018af6d2b686c2ce051f03d968f7464ecb1372a7e8
GRAFANA_VERSION=13.2.2
GRAFANA_SHA256=9662c838a09824fdb072e5f6fbdd45b62cf541b20f3d609ea5011e6e5f544c8f
# traces and logs (backlog E10-S3): Tempo (tar.gz) and Loki (zip), each project's SHA256SUMS
TEMPO_VERSION=3.0.3
TEMPO_SHA256=7ac4f095dfaee3ba77dbdbb23ebd9f8a021cb6895c3602244ee3bf2787d8ceba
LOKI_VERSION=3.7.8
LOKI_SHA256=62aea42c9cba52cd1642b3666ab37019a0ce4c24ab50b07e85dccc8d812f7d61

# AWQ/INT4 quantization of the fine-tuned DSLM (backlog E2-S6, docs/quantization.md): an offline
# step in its own venv (.venv-quant, requirements-quant.lock). llm-compressor 0.7.1.4 writes
# compressed-tensors 0.11.0 (what vLLM 0.11.0 reads) on torch 2.8, and caps transformers at 4.55.2.
LLMCOMPRESSOR_VERSION=0.7.1.4
QUANT_TRANSFORMERS_VERSION=4.55.2

# de-identification (backlog E11-S4): the spaCy English model is not on PyPI; it goes into
# requirements.lock as this release wheel + sha256. The clinical NER model is pinned by commit
# in config.py (CDI_DEID_NER_REVISION) and fetched with `python -m cdi_adapter.deid fetch-models`.
SPACY_MODEL_WHEEL=https://github.com/explosion/spacy-models/releases/download/en_core_web_lg-3.8.0/en_core_web_lg-3.8.0-py3-none-any.whl
SPACY_MODEL_SHA256=293e9547a655b25499198ab15a525b05b9407a75f10255e405e8c3854329ab63

# HL7 FHIR validator + the ABDM IG it checks against (backlog E6-S1; upgrades: docs/ig-upgrade.md,
# E6-S5). The jar is the HAPI release asset; FHIR_IG must equal CDI_IG_PACKAGE in .env, and every
# package the validator uses is pinned with a digest in infra/fhir/packages.lock.
FHIR_VALIDATOR_VERSION=6.10.4
FHIR_VALIDATOR_SHA256=1106b9d58f9e363e47bea7c4fc065841e5fc91fe9d062775c3bfdd212bd653cc
FHIR_IG=ndhm.in#6.5.0
FHIR_IG_SHA256=fc5a7a539238fb30dd9134b4c915a62c8bc052db1e5d286af98d74a0a730cafe
