# Ingress VM settings (backlog E1-S9). Copy to /etc/cdi-ingress.env (root, 0600) on the VM and
# run: sudo bash infra/ingress/setup_ingress_vm.sh /etc/cdi-ingress.env    (runbook: docs/ingress.md)
# Values are double-quoted: bash and systemd both read this format.

# the one address staff use; a DNS A record for it points at this VM's public IP
CDI_INGRESS_HOSTNAME="emr.example.in"

# Let's Encrypt account e-mail (certificate expiry notices)
CDI_INGRESS_ACME_EMAIL="it@example.in"

# clinic networks allowed to open the UI, space-separated CIDRs (never 0.0.0.0/0: patient data, even behind sign-in)
CDI_INGRESS_ALLOW="203.0.113.10/32 198.51.100.0/28"

# one line per pod/host that may open the tunnel; start_tunnel.sh prints its key on first boot
CDI_INGRESS_POD_KEYS="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPLACEHOLDERPLACEHOLDERPLACEHOLDERPLAC cdi-pod-tunnel"

# VM-local port the tunnel listens on (must match CDI_INGRESS_REMOTE_PORT on the pod)
CDI_INGRESS_REMOTE_PORT="18888"
