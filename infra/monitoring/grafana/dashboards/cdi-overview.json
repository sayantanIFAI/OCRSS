{
  "uid": "cdi-overview",
  "title": "CDI-Adapter overview",
  "description": "Backlog E10-S2. Metrics: docs/metrics.md. On-call: docs/alerts.md.",
  "tags": [
    "cdi"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "type": "alertlist",
      "title": "Firing and pending alerts",
      "options": {
        "stateFilter": {
          "firing": true,
          "pending": true
        },
        "maxItems": 20,
        "viewMode": "list",
        "sortOrder": 1
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Job time p95 vs the 5-minute SLA (ADR-0002)",
      "description": "Alert CdiSlaWindowBreach: docs/alerts.md",
      "datasource": {
        "type": "prometheus",
        "uid": "cdi-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "cdi-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(cdi_job_seconds_bucket[15m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "cdi-prometheus"
          },
          "expr": "max(cdi_job_oldest_running_seconds)",
          "legendFormat": "oldest running job"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
